# Local demo configuration. Do not commit real credentials.
# GHOSTWASTE_DB_PATH=./data/ghostwaste.db
# Set false in production after `alembic upgrade head`.
# GHOSTWASTE_AUTO_SCHEMA=true
# GHOSTWASTE_API_TOKEN=replace-with-a-local-secret
# GHOSTWASTE_CORS_ORIGINS=http://localhost:3000
# BACKEND_ORIGIN=http://127.0.0.1:8000
# Staging only: set secrets in the provider dashboard, never in a committed .env file.
# STAGING_AUTH_REQUIRED=true
# GHOSTWASTE_STAGING_MODE=true
# STAGING_AUTH_USER=manager
# STAGING_AUTH_PASSWORD=generate-a-long-random-value
# API_INTERNAL_TOKEN=same-secret-as-GHOSTWASTE_API_TOKEN
# GHOSTWASTE_ALLOWED_HOSTS=api.railway.internal,healthcheck.railway.app
# GHOSTWASTE_ENABLE_DOCS=false
