FROM node:22-alpine AS build
WORKDIR /app
ARG BACKEND_ORIGIN=http://127.0.0.1:8000
ENV BACKEND_ORIGIN=$BACKEND_ORIGIN
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web ./
RUN npm run build
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["/bin/sh", "-c", "exec npm run start -- --hostname 0.0.0.0 --port ${PORT:-3000}"]
